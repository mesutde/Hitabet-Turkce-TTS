{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hitabet",
  "version": "0.1.0",
  "identifier": "com.ema-lightning.tts",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run sync-models",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hitabet – Türkçe Seslendirme",
        "width": 960,
        "height": 820,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../models/onnx": "models/onnx",
      "../models/antalia": "models/antalia"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
